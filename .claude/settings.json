{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"/home/david/Projects/DJI-Overlay/.claude/hooks/session_start.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"/home/david/Projects/DJI-Overlay/.claude/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "memanto",
            "args": [
              "memory",
              "sync",
              "--project-dir",
              "/home/david/Projects/DJI-Overlay"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(memanto *)",
            "command": "python \"/home/david/Projects/DJI-Overlay/.claude/hooks/notify.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(memanto *)",
            "command": "python3 \"/home/david/Projects/DJI-Overlay/.claude/hooks/notify.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
